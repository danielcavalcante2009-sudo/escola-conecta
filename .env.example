# Copie para .env.local e preencha com as credenciais do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# CHAVE SECRETA — usada apenas no servidor (rotas de administração). NUNCA exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=service-role-key
